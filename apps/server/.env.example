DATABASE_URL=postgresql://postgres:password@localhost:5433/tccc_medical_db
PORT=4000
CORS_ORIGIN=http://localhost:3000,https://recent-strobe-saturday.ngrok-free.dev
# Shared secret every medic device enters under Settings → Sync as its Unit Token.
# At least 16 characters; the server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_UNIT_TOKEN=
# Server errors are logged with the request or mutation payload, which holds casualty data
# (names, notes). Set to false where logs leave the unit.
LOG_ERROR_PAYLOADS=true
