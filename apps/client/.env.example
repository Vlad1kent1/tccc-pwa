# Origin of the API. Request paths already include /api.
# Use a public tunnel URL when the app is opened from another device.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Shows the Settings dev tools panel (generate mock cards, reset the local
# database). Leave unset for a clean deployment. Restart `pnpm dev` after changing.
# NEXT_PUBLIC_DEV_TOOLS=true
