{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:3100/", "http://127.0.0.1:3100/casualties/new", "http://127.0.0.1:3100/~offline"],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices", "pwa"]
      }
    },
    "assert": {
      "assertions": {
        "categories:pwa": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.5 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "e2e/results/lighthouse"
    }
  }
}
