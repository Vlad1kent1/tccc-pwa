{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(!**/.env.example)",
      "Bash(pnpm db:wipe*)",
      "Bash(pnpm run db:wipe*)",
      "Bash(pnpm --filter server db:wipe*)",
      "Bash(pnpm --filter server run db:wipe*)",
      "Bash(pnpm db:seed:mock*)",
      "Bash(pnpm run db:seed:mock*)",
      "Bash(pnpm --filter server db:seed:mock*)",
      "Bash(pnpm --filter server run db:seed:mock*)",
      "Bash(*prisma migrate reset*)",
      "Bash(pnpm --filter e2e report*)",
      "Bash(pnpm --filter e2e run report*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)"
    ],
    "allow": [
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm test *)",
      "Bash(pnpm --filter client typecheck *)",
      "Bash(pnpm --filter client lint)",
      "Bash(pnpm --filter client test *)",
      "Bash(pnpm --filter client build *)",
      "Bash(pnpm --filter server typecheck *)",
      "Bash(pnpm --filter server lint)",
      "Bash(pnpm --filter server format:check)",
      "Bash(pnpm --filter server test *)",
      "Bash(pnpm --filter server build *)",
      "Bash(pnpm --filter @tccc/shared typecheck *)",
      "Bash(pnpm --filter @tccc/shared test *)",
      "Bash(pnpm --filter @tccc/shared build *)",
      "Bash(pnpm --filter e2e typecheck *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-command.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-stop.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
