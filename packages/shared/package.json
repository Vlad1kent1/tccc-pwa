    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
